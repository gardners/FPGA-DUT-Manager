	(text "K325T outlet: 6.0 V, designed for 4 A continuous, limit 4.45 A (auto-retry).\nOff (6V_EN low): U71 open, buck unpowered, U72 open via D730.\nOn: VIN6 ramps (~0.9 V/ms), buck soft-starts at VIN6 ~6-8 V, U72 closes at +6V > 5.4 V\nand ramps OUT6V at ~0.9 V/ms (0.9 A into 1000 uF)."
		(exclude_from_sim no)
		(at 320.04 556.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b42b1442-4a1a-576f-8a6c-d568310fb79e")
	)
